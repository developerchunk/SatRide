# Firebase Web app config for satride.developerstring.com.
#
# From Firebase console → Project settings → Your apps → Web (“SatRide”). Copy to `.env`.
# `.env` is gitignored and must stay that way.
#
# The apiKey is not a secret — it ships inside any web client and identifies the project rather
# than authorising anything — but it is per-project, so it is configured rather than committed.
# What actually protects your data is Firestore rules, not this string.
#
# CI/hosting: set the same names as build-time environment variables; Vite inlines any VITE_*.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=skyrf-3964a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skyrf-3964a
VITE_FIREBASE_STORAGE_BUCKET=skyrf-3964a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1059998960182
VITE_FIREBASE_APP_ID=1:1059998960182:web:578bac578adb7c7bf72697
