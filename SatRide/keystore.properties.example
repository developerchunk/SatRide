# Copy to `keystore.properties` and fill in. That file is gitignored and must stay that way —
# anyone with it and the .jks can publish an update to your app.
#
# The keystore itself is deliberately kept outside the repository, so a clone can never contain it.
# `storeFile` is an absolute path.
#
# CI does not use this file: the build falls back to the environment variables
# SATRIDE_STORE_FILE, SATRIDE_STORE_PASSWORD, SATRIDE_KEY_ALIAS and SATRIDE_KEY_PASSWORD.

storeFile=/absolute/path/to/upload-keystore.jks
storePassword=
keyAlias=
keyPassword=
